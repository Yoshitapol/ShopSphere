# ============================================================================
# ShopSphere Environment Configuration (.env.example)
# Experiment 10: Environment Variable Security
# Copy this file to `.env` or `.env.local` and fill in your credentials.
# NEVER commit `.env` or `.env.local` containing real secrets to Git!
# ============================================================================

# ----------------------------------------------------------------------------
# 1. MySQL Transactional Database (Experiment 5 - Prisma ORM)
# Owns: Users, Better Auth Sessions/Accounts, Roles, Categories, InventoryItems, Orders, OrderItems
# Localhost URL (when running Next.js on host machine):
DATABASE_URL="mysql://shopsphere_user:shopsphere_password@localhost:3306/shopsphere_db"
# Docker Compose network URL (used inside the app container - see docker-compose.yml):
# DATABASE_URL="mysql://shopsphere_user:shopsphere_password@mysql:3306/shopsphere_db"

# ----------------------------------------------------------------------------
# 2. MongoDB Product Catalog Database (Experiment 6 - Mongoose ODM)
# Owns: Product Catalog Documents (descriptions, images, flexible specifications, tags, ratings)
# Localhost URL (when running Next.js on host machine):
MONGODB_URI="mongodb://shopsphere_admin:shopsphere_mongo_password@localhost:27017/shopsphere_catalog?authSource=admin"
# Docker Compose network URL (used inside the app container - see docker-compose.yml):
# MONGODB_URI="mongodb://shopsphere_admin:shopsphere_mongo_password@mongodb:27017/shopsphere_catalog?authSource=admin"

# ----------------------------------------------------------------------------
# 3. Better Auth Configuration (Experiment 7 & Experiment 8)
# Generate a strong secret using: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-at-least-32-char-random-secret-key-for-better-auth"
BETTER_AUTH_URL="http://localhost:3000"

# ----------------------------------------------------------------------------
# 4. OAuth 2.0 Provider Credentials (Experiment 7 - Server-Only Secrets)
# Callback URL for Google: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# Callback URL for GitHub: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID="your-github-oauth-app-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-app-client-secret"

# ----------------------------------------------------------------------------
# 5. Local Development & Lab Practical Helpers (Server-Only)
# Allows switching between Guest, Customer, and Admin personas in local dev
# when live OAuth or external DBs are not configured during a viva.
# Automatically disabled when NODE_ENV="production" unless explicitly enabled.
ENABLE_DEV_AUTH_SWITCHER="true"

# ----------------------------------------------------------------------------
# 6. Public Client-Safe Variables (Experiment 10 - Safe for Browser Bundle)
# ONLY variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# NEVER put secrets, database URLs, or private API keys in NEXT_PUBLIC_*!
NEXT_PUBLIC_APP_NAME="ShopSphere"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CURRENCY_CODE="INR"
NEXT_PUBLIC_CURRENCY_SYMBOL="₹"
